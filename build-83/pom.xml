<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nedama.signal</groupId>
        <artifactId>signal-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>signal-build-83</artifactId>
    <packaging>pom</packaging>

    <name>Signal Processing Module Build (Ignition 8.3)</name>
    <description>Packages the core, common and scope jars into the .modl file for Ignition 8.3.</description>

    <properties>
        <module-name>Signal Processing</module-name>
        <module-description>Signal processing for Ignition scripts, matching scipy.signal: filter design, zero-phase filtering, smoothing, peak finding, spectra and resampling.</module-description>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.nedama.signal</groupId>
            <artifactId>signal-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nedama.signal</groupId>
            <artifactId>signal-common-83</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nedama.signal</groupId>
            <artifactId>signal-gateway-83</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nedama.signal</groupId>
            <artifactId>signal-client-83</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nedama.signal</groupId>
            <artifactId>signal-designer-83</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.inductiveautomation.ignitionsdk</groupId>
                <artifactId>ignition-maven-plugin</artifactId>
                <version>1.1.0</version>

                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>modl</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <!-- Each name below must equal that project's Maven <name>, which is set to its artifactId.
                         If they differ, the plugin logs ignitionScope=null and builds a module with no jars in it. -->
                    <projectScopes>
                        <projectScope>
                            <name>signal-core</name>
                            <scope>CDG</scope>
                        </projectScope>
                        <projectScope>
                            <name>signal-common-83</name>
                            <scope>CDG</scope>
                        </projectScope>
                        <projectScope>
                            <name>signal-gateway-83</name>
                            <scope>G</scope>
                        </projectScope>
                        <projectScope>
                            <name>signal-client-83</name>
                            <scope>C</scope>
                        </projectScope>
                        <projectScope>
                            <name>signal-designer-83</name>
                            <scope>D</scope>
                        </projectScope>
                    </projectScopes>

                    <!-- The same module ID as the 8.1 build, on purpose: a gateway upgraded from 8.1 to 8.3 then recognises this
                         as the same module. Never change it after the first install anywhere. -->
                    <moduleId>com.nedama.ignition.signal</moduleId>
                    <moduleName>${module-name}</moduleName>
                    <moduleDescription>${module-description}</moduleDescription>
                    <moduleVersion>${signal.module-version-83}</moduleVersion>
                    <requiredIgnitionVersion>${signal.required-ignition-83-version}</requiredIgnitionVersion>
                    <licenseFile>license.html</licenseFile>

                    <hooks>
                        <hook>
                            <scope>C</scope>
                            <hookClass>com.nedama.signal.client83.SignalClientHook</hookClass>
                        </hook>
                        <hook>
                            <scope>D</scope>
                            <hookClass>com.nedama.signal.designer83.SignalDesignerHook</hookClass>
                        </hook>
                        <hook>
                            <scope>G</scope>
                            <hookClass>com.nedama.signal.gateway83.SignalGatewayHook</hookClass>
                        </hook>
                    </hooks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
